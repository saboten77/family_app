<div class="dashboard <%= @background %>">

  <header class="home-header">
    <%= link_to "☰", mypage_path, class: "menu-button" %>

  </header>

  <div class="status-card">

  <div class="status-label">

  </div>

  <div class="status-top">

  <div class="energy-title">
  🏠 家族エネルギー
  </div>

  <div class="energy-value">
  <%= @energy.round %><span>%</span>
  </div>

  <div class="bonus-value">

    <div>
    ⚖️ 役割ボーナス
    +<%= @bonus_info[:role_bonus] %>%
    </div>
  家事の実施数と家族の分担割合で上がるよ✨
  </div>

</div>

  <div class="energy-bar">
    <div
      class="energy-fill"
      style="width:<%= [@energy,100].min %>%;">
    </div>
  </div>

</div>

<div class="room-area">

  <div class="room-area">

  <%= link_to board_posts_path, class: "whiteboard-link" do %>

  <div class="whiteboard">

    <div class="whiteboard-title">
      📝 伝言板
    </div>

    <div class="whiteboard-content">

      <% if @board_posts.any? %>

        <% @board_posts.each do |post| %>
          <p>📌 <%= truncate(post.body, length: 28) %></p>
        <% end %>

      <% else %>

        <p>📝 まだメモはありません</p>
        <p>タップして書き込もう✨</p>

      <% end %>

    </div>

  </div>

<% end %>

  <% @characters.each do |character| %>

    <div class="ponkichi"
         style="
           left:<%= character[:position][:left] %>;
           top:<%= character[:position][:top] %>;
         ">

      <%= image_tag character[:image],
            class: "ponkichi-image" %>

    </div>

  <% end %>

</div>

<nav class="bottom-nav">
  <%= link_to task_categories_path, class: "nav-item" do %>
    <div class="icon">🧺</div>
    <div class="label">家事記録</div>
  <% end %>

  <%= link_to task_histories_path, class: "nav-item" do %>
    <div class="icon">📅</div>
    <div class="label">家事履歴</div>
  <% end %>

  <%= link_to gacha_path, class: "nav-item" do %>
    <div class="icon">🎰</div>
    <div class="label">ガチャ</div>
  <% end %>

  <%= link_to reward_cards_path, class: "nav-item" do %>
    <div class="icon">🎁</div>
    <div class="label">カード</div>
  <% end %>
</nav>


</div>
