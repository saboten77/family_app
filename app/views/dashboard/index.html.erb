<div class="dashboard <%= @background %>">

  <header class="home-header">
    <%= link_to "☰", mypage_path, class: "menu-button" %>

  </header>

  <div class="status-card">

  <div class="status-label">

  </div>

  <div class="status-top">

  <div class="energy-title">
  🏠 家族エネルギー
  </div>

  <div class="energy-value">
  <%= @energy.round %><span>%</span>
  </div>

  <div class="bonus-value">

    <div>
      🤝 家族協力
      +<%= @bonus_info[:family_bonus] %>
    </div>

    <div>
      ⚖️ 役割ボーナス
      +<%= @bonus_info[:role_bonus] %>
    </div>

  </div>

</div>

  <div class="energy-bar">
    <div
      class="energy-fill"
      style="width:<%= [@energy,100].min %>%;">
    </div>
  </div>

</div>

<div class="room-area">

  <% @characters.each do |character| %>

  <div class="ponkichi"
       style="
         left:<%= character[:position][:left] %>;
         top:<%= character[:position][:top] %>;
       ">

    <%= image_tag character[:image],
          class: "ponkichi-image" %>

  </div>

<% end %>

</div>

  <nav class="bottom-nav">
    <%= link_to task_categories_path, class: "nav-item" do %>
      <div class="icon">🧺</div>
      <div class="label">家事記録</div>
    <% end %>

    <%= link_to task_histories_path, class: "nav-item" do %>
      <div class="icon">📅</div>
      <div class="label">家事履歴</div>
    <% end %>
  </nav>

</div>
