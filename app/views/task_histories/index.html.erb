<div class="task-log-page">

  <h1 class="page-title">
    📖 家事履歴
  </h1>

  <div class="task-log-list">

    <% @task_logs.each do |log| %>

      <div class="task-log-card">

        <div>
          🧺 <%= log.task.name %>
        </div>

        <div>
          👤 <%= log.family_member.user.name %>
        </div>

        <div>
          📅 <%= log.completed_at.strftime("%Y年%m月%d日") %>
        </div>

        <div>
          🌱 +1pt
        </div>

      </div>

    <% end %>

  </div>
<div class="dashboard-back">
  <%= link_to dashboard_path, class: "back-home-button" do %>
    🏠 ポン吉のお家へ戻る
  <% end %>
</div>

</div>