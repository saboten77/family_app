<div class="task-log-page">

  <h1 class="page-title">
    📖 家事履歴
  </h1>

  <div class="task-log-list">

    <% @task_logs.group_by { |log| log.completed_at.to_date }.each do |date, logs| %>

      <h2 class="date-header">
        📅 <%= date.strftime("%Y年%m月%d日") %>
      </h2>

      <div class="task-log-card">

        <% logs.each do |log| %>

          <div class="task-log-row">

            <div class="task-info">
              <div>🧺 <%= log.task.name %></div>
              <small>👤 <%= log.family_member.user.name %></small>
            </div>

            <div class="task-point">
              🌱 +1pt
            </div>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>

  <div class="dashboard-back">
    <%= link_to dashboard_path, class: "back-home-button" do %>
      🏠 ポン吉のお家へ戻る
    <% end %>
  </div>

</div>

<div class="pagination-area">
  <%= paginate @task_logs %>
</div>
