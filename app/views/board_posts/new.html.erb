<div class="board-post-page">

  <h1 class="page-title">
    📝 ホワイトボードに書く
  </h1>

<% if @board_full %>

<div class="board-full-message">
  <div class="board-full-icon">📌</div>

  <h2>ホワイトボードがいっぱいです</h2>

  <p>
    付箋は3枚まで貼れます。
  </p>

  <p>
    貼ってある付箋を1枚剥がすと、<br>
    新しい付箋を貼れるようになります。
  </p>

  <%= link_to "📋 ホワイトボードを見る",
              board_posts_path,
              class: "board-write-button" %>
</div>

<% else %>

<div class="board-post-form">

  <%= form_with model: @board_post, local: true do |form| %>

    <div class="form-group">
      <%= form.label :body, "家族に伝えたいこと" %>

      <%= form.text_area :body,
                         rows: 6,
                         placeholder: "ここに書いてね ✏️" %>
    </div>

    <%= form.submit "📌 ホワイトボードに貼る",
                    class: "record-button" %>

  <% end %>

</div>

<% end %>

  <div class="back-button-area">
    <%= link_to "← ホワイトボードに戻る",
                board_posts_path,
                class: "back-button" %>
  </div>

</div>
