<div class="task-log-page">

  <h1 class="page-title">
    🏡 家族の家事記録
  </h1>

  <div class="task-log-list">

    <% @task_logs.each do |log| %>

      <div class="task-log-card">

        <div class="task-log-task">
          🧺 <%= log.task.name %>
        </div>

        <div class="task-log-info">
          👤 <%= log.family_member.user.name %>
        </div>

        <div class="task-log-date">
          📅 <%= log.completed_at.strftime("%Y年%m月%d日") %>
        </div>

        <div class="task-log-point">
          🌱 +1pt
        </div>

      </div>

    <% end %>

  </div>

</div>

<div class="pagination-area">
  <%= paginate @task_logs %>
</div>
