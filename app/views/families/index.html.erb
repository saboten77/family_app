<h1 class="page-title">👨‍👩‍👧 家族管理</h1>

<% if current_user.families.any? %>
  <% family = current_user.families.first %>

  <div class="family-card-wrapper">
    <div class="family-card">
      <p class="family-title">🏠 家族名</p>
      <p><%= family.name %></p>

      <p class="family-title">🔑 招待コード</p>
      <p class="invite-code"><%= family.invite_code %></p>

      <button class="copy-button">📋 コピーする</button>
    </div>
  </div>

<% else %>
  <p class="no-family">まだ家族はいません</p>
<% end %>

<div class="back-button-area">
  <%= link_to "🌿 マイページへ戻る", mypage_path, class: "back-button" %>
</div>