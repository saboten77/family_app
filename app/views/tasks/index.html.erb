<div class="task-page">

  <h1 class="page-title">🧹 家事一覧</h1>

  <div class="task-list">

    <% @tasks.each do |task| %>

      <%= link_to new_task_log_path(task_id: task.id), class: "task-card" do %>

        <div class="task-name">
          🏠 <%= task.name %>
        </div>

      <% end %>

    <% end %>

  </div>

</div>