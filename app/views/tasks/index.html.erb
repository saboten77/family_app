<div class="task-page">

  <h1 class="page-title">🧹 今日やった家事を選んでね</h1>

  <%= form_with url: task_logs_path, method: :post, local: true do %>

    <div class="task-list">

      <% @tasks.each do |task| %>

      <label class="task-select-card">
        <%= check_box_tag "task_ids[]", task.id, false, class: "task-checkbox" %>

      <div class="task-name">
      🏠 <%= task.name %>
      </div>
      </label>

      <% end %>

    </div>

    <div class="task-submit-area">
      <%= submit_tag "まとめて記録する", class: "task-submit-button" %>
    </div>

  <% end %>

  <div class="back-button-area">
    <%= link_to "← 家事項目にもどる",
                task_categories_path,
                class: "back-button" %>
  </div>

</div>
