<%= stylesheet_link_tag "reward_cards", "data-turbo-track": "reload" %>

<div class="reward-approved-page">

  <div class="reward-approved-card">

    <div class="reward-approved-message">
      🎉 みんなOK！
    </div>

    <%= image_tag "reward_cards/#{@reward_card.image}",
      class: "reward-approved-image" %>

    <h2>
      このご褒美を使う？🐹
    </h2>

    <p class="reward-approved-text">
      家族のみんながOKしてくれたよ💛
    </p>

    <div class="reward-approved-actions">

      <%= button_to "💛 ありがとう！",
        destroy_approved_reward_card_path(@user_reward_card),
        method: :delete,
        class: "reward-approved-thanks" %>

      <%= link_to "↩ 戻る",
        reward_cards_path,
        class: "reward-approved-back" %>

    </div>

  </div>

</div>
