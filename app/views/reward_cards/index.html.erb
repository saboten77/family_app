<%= stylesheet_link_tag "reward_cards", "data-turbo-track": "reload" %>

<!-- =========================
     タブ
     ========================= -->

<div class="reward-tabs">

  <button
    type="button"
    class="reward-tab active"
    data-tab="my-rewards">
    🎁 自分のカード
  </button>

  <button
    type="button"
    class="reward-tab"
    data-tab="family-requests">
    💌 家族からの依頼
  </button>

</div>


<!-- =========================
     自分のカード
     ========================= -->

<div
  id="my-rewards"
  class="reward-tab-content active">

  <% if @user_reward_cards.any? %>

    <div class="reward-cards-grid">

      <% @user_reward_cards.each do |user_reward_card| %>

        <% reward_requests = @my_reward_requests.select { |request|
          request.user_reward_card_id == user_reward_card.id
        } %>

        <% pending_requests = reward_requests.select { |request|
          request.status == "pending"
        } %>

        <% completed_requests = reward_requests.select { |request|
          request.status == "completed"
        } %>


        <% if pending_requests.any? %>

          <!-- =========================
               依頼中
               ========================= -->

          <div class="reward-card reward-card--pending">

            <%= image_tag "reward_cards/#{user_reward_card.reward_card.image}",
              class: "reward-card-image" %>

            <div class="reward-requesting">
              💌 家族に依頼中
            </div>

            <div class="reward-progress">
              <%= completed_requests.count %> /
              <%= reward_requests.count %>人OK
            </div>

          </div>


        <% elsif completed_requests.any? %>

          <!-- =========================
               全員OK
               ========================= -->

          <%= link_to approved_reward_card_path(user_reward_card),
            class: "reward-card reward-card--approved" do %>

            <%= image_tag "reward_cards/#{user_reward_card.reward_card.image}",
              class: "reward-card-image" %>

            <div class="reward-requesting">
              🎉 みんなOK！
            </div>

          <% end %>


        <% else %>

          <!-- =========================
               まだ依頼していない
               ========================= -->

          <%= link_to use_reward_card_path(user_reward_card),
            class: "reward-card" do %>

            <%= image_tag "reward_cards/#{user_reward_card.reward_card.image}",
              class: "reward-card-image" %>

          <% end %>

        <% end %>

      <% end %>

    </div>

  <% else %>

    <div class="reward-empty">
      まだご褒美カードを持っていないよ🐹
    </div>

  <% end %>

</div>


<!-- =========================
     家族からの依頼
     ========================= -->

<div
  id="family-requests"
  class="reward-tab-content">

  <% if @reward_requests.any? %>

    <div class="reward-requests-list">

      <% @reward_requests.each do |request| %>

        <%= link_to confirm_reward_card_path(request),
          class: "reward-request-card" do %>

          <div class="reward-request-message">
            💌
            <%= request.requester_user.name.presence || "家族" %>
            からご褒美依頼がきたよ！
          </div>

          <%= image_tag "reward_cards/#{request.reward_card.image}",
            class: "reward-request-image" %>

        <% end %>

      <% end %>

    </div>

  <% else %>

    <div class="reward-empty">
      💌 家族からの依頼はまだないよ🐹
    </div>

  <% end %>

</div>


<!-- =========================
     ホーム
     ========================= -->

<div class="reward-home-link">

  <%= link_to "🏠 ホームに戻る",
    dashboard_path,
    class: "reward-home-button" %>

</div>
