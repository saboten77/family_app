<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Family App" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Family App">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path('ponkichi-icon.png') %>" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path('ponkichi-icon.png') %>">

    <%# 全体共通CSS %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "dashboard", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "my_pages", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "profiles", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "families", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "entry", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "task_categories", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "task_logs", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "complete", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "family_management", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "role_settings", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "role_settings", "character_select", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "auth", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "legal", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "contacts", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "account_delete", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "about", "data-turbo-track": "reload" %>

    <%# ホワイトボード画面だけCSSを読み込む %>
    <% if controller_name == "board_posts" %>
      <%= stylesheet_link_tag "board_posts", "data-turbo-track": "reload" %>
    <% end %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
