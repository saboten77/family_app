
<div class="profile-container">

  <div class="profile-card">

    <h1>プロフィール設定</h1>

    <p class="subtitle">
      あなたの分身になるキャラクターと<br>
      ニックネームを決めよう！
    </p>

    <%= form_with model: @user, url: profile_path do |f| %>

      <h3>キャラクターを選んでください</h3>

      <div class="character-grid">

        <label class="character-card">
          <%= f.radio_button :character, "A" %>
          <div class="character-image">🐻</div>
          <p>A</p>
        </label>

        <label class="character-card">
          <%= f.radio_button :character, "B" %>
          <div class="character-image">🐰</div>
          <p>B</p>
        </label>

        <label class="character-card">
          <%= f.radio_button :character, "C" %>
          <div class="character-image">🦊</div>
          <p>C</p>
        </label>

        <label class="character-card">
          <%= f.radio_button :character, "D" %>
          <div class="character-image">🐼</div>
          <p>D</p>
        </label>

      </div>

      <div class="field">
        <%= f.label :nickname, "ニックネーム" %>
        <%= f.text_field :nickname, placeholder: "ポン吉" %>
      </div>

      <%= f.submit "次へ", class: "next-btn" %>

    <% end %>

  </div>

</div>
