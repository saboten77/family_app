
<div class="profile-container">

  <div class="profile-card">

    <h1>プロフィール設定</h1>

    <p class="subtitle">
      あなたの分身になるキャラクターと<br>
      ニックネームを決めよう！
    </p>

    <%= form_with model: @user, url: profile_path, method: :patch do |f| %>

    <% if @user.errors.any? %>
    <div class="error-messages">
    <% @user.errors.full_messages.each do |message| %>
    <p><%= message %></p>
    <% end %>
    </div>
    <% end %>

  <h3>キャラクター</h3>

<div class="selected-character">
  <%= image_tag "characters/#{@user.character || 'character1'}.png",
                class: "profile-character" %>
</div>

<%= link_to "変更する", profile_select_character_path, class: "change-character-btn" %>

      <div class="field">
        <%= f.label :name, "ニックネーム" %>
        <%= f.text_field :name, placeholder: "ポン吉" %>
      </div>

      <%= f.submit "次へ", class: "next-btn" %>

    <% end %>

  </div>

</div>
