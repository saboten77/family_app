<div class="entry-wrapper">

  <div class="entry-box">

    <h2>🔑 パスワード変更</h2>

    <p class="sub-text">
      新しいパスワードを設定してね🌱
    </p>


    <%= form_for(@user,
      url: update_account_password_path,
      html: { method: :patch }) do |f| %>


      <%= render "devise/shared/error_messages", resource: @user %>


      <div class="field">

        <%= f.label :current_password, "現在のパスワード" %>

        <%= f.password_field :current_password,
          autocomplete: "current-password",
          placeholder: "今のパスワード" %>

      </div>


      <div class="field">

        <%= f.label :password, "新しいパスワード" %>

        <% if @minimum_password_length %>
          <p class="password-note">
            ※ <%= @minimum_password_length %>文字以上
          </p>
        <% end %>

        <%= f.password_field :password,
          autocomplete: "new-password",
          placeholder: "新しいパスワード" %>

      </div>


      <div class="field">

        <%= f.label :password_confirmation, "確認用パスワード" %>

        <%= f.password_field :password_confirmation,
          autocomplete: "new-password",
          placeholder: "もう一度入力してね" %>

      </div>


      <div class="actions">

        <%= f.submit "🐻 パスワードを変更する",
          class: "submit-button" %>

      </div>


    <% end %>
<div class="back-button-area">
  <%= link_to "🌿 マイページへ戻る", mypage_path, class: "back-button" %>
</div>

  </div>

</div>
