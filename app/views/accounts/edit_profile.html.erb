<div class="account-page">

  <div class="profile-card">

    <h1>プロフィール変更</h1>

    <%= form_with model: @user,
              url: update_account_profile_path,
              method: :patch do |f| %>

      <p>🐹 キャラクター</p>

<%= link_to profile_change_character_path do %>
  <%= image_tag "characters/#{@user.character || 'character1'}.png",
                class: "profile-character" %>
<% end %>
      <br><br>

      <div class="field">
        <%= f.label :name, "ニックネーム" %><br>
        <%= f.text_field :name, placeholder: "ポン吉" %>
      </div>

      <br>

      <%= f.submit "保存", class: "save-button" %>

    <% end %>

  </div>

</div>
