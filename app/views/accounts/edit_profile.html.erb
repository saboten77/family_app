<div class="account-page">

  <div class="profile-card">

    <h1>プロフィール変更</h1>

    <%= form_with model: @user, url: profile_path, method: :patch do |f| %>

      <p>🐹 キャラクター</p>

      <button type="button">ポン吉</button>

      <br><br>

      <div class="field">
        <%= f.label :name, "ニックネーム" %><br>
        <%= f.text_field :name, placeholder: "友希" %>
      </div>

      <br>

      <%= f.submit "保存", class: "save-button" %>

    <% end %>

  </div>

</div>